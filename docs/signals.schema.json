{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asensio94.github.io/estado-iba/signals.schema.json",
  "title": "signals.json",
  "description": "Señales que un proyecto publica para Estado de las IBA (CONTRATO.md). Versión 1: toda España. Versión 2: cada señal lleva su país y la cobertura va por país.",
  "type": "object",
  "required": ["source", "version", "generated", "coverage", "signals"],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "version": {"enum": [1, 2]},
    "generated": {"type": "string", "minLength": 1},
    "signals": {"type": "array"}
  },
  "if": {"properties": {"version": {"const": 1}}},
  "then": {
    "properties": {
      "coverage": {"$ref": "#/$defs/coverage"},
      "signals": {"items": {"allOf": [
        {"$ref": "#/$defs/signal"},
        {"properties": {
          "country": {"const": "ES"},
          "municipalities": {"items": {"$ref": "#/$defs/ine"}}
        }}
      ]}}
    }
  },
  "else": {
    "properties": {
      "coverage": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {"$ref": "#/$defs/country"},
        "additionalProperties": {"$ref": "#/$defs/coverage"}
      },
      "signals": {"items": {"allOf": [
        {"$ref": "#/$defs/signal"},
        {"required": ["country"]},
        {"if": {"properties": {"country": {"const": "FR"}}},
         "then": {"properties": {"municipalities": {"items": {"$ref": "#/$defs/insee"}}}},
         "else": {"properties": {"municipalities": {"items": {"$ref": "#/$defs/ine"}}}}}
      ]}}
    }
  },
  "$defs": {
    "country": {"description": "ISO 3166-1 alfa-2 de los países que el hub conoce.", "enum": ["ES", "FR"]},
    "ine": {"description": "Código INE de municipio, 5 cifras.", "type": "string", "pattern": "^\\d{5}$"},
    "insee": {"description": "Código INSEE de commune; Córcega usa 2A y 2B.", "type": "string",
              "pattern": "^(\\d{5}|2[AB]\\d{3})$"},
    "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "coverage": {
      "type": "object",
      "required": ["label", "sites"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "sites": {"description": "null: todo el país; si no, los SITECODE vigilados.",
                  "oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "string", "minLength": 1}}]},
        "note": {"type": "string"}
      }
    },
    "signal": {
      "type": "object",
      "required": ["id", "kind", "date", "title", "url", "precision"],
      "properties": {
        "id": {"type": ["string", "integer"], "minLength": 1},
        "country": {"$ref": "#/$defs/country"},
        "kind": {"enum": ["notice", "resolution", "fire", "land_change", "wetland_water", "river_flow",
                          "power_line", "migration", "night_light"]},
        "date": {"$ref": "#/$defs/day"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "sites": {"type": "array", "items": {
          "type": "object", "required": ["code"],
          "properties": {"code": {"type": "string", "minLength": 1}, "ha": {"type": ["number", "null"]}}}},
        "municipalities": {"type": "array"},
        "municipality_names": {"type": "array", "items": {"type": "string"}},
        "provinces": {"type": "array", "items": {"type": "string"}},
        "precision": {"enum": ["parcelas", "municipio", "perimetro", "focos", "punto", "lamina", "pixeles", "radar"]},
        "deadline": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/day"}]},
        "status": {"type": ["string", "null"]},
        "value": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["amount", "unit"]}]},
        "details": {"type": "object", "properties": {
          "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}}
      }
    }
  }
}
